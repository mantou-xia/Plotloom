{
  "name": "plotloom",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env apps/server/src/main.ts",
    "web": "pnpm --filter @plotloom/web dev",
    "web:build": "pnpm --filter @plotloom/web build",
    "web:preview": "pnpm --filter @plotloom/web preview",
    "ui": "pnpm --filter @plotloom/ui-demo dev",
    "ui:build": "pnpm --filter @plotloom/ui-demo build",
    "ui:preview": "pnpm --filter @plotloom/ui-demo preview",
    "demo": "pnpm --filter @plotloom/api-demo dev",
    "demo:build": "pnpm --filter @plotloom/api-demo build",
    "demo:preview": "pnpm --filter @plotloom/api-demo preview",
    "test:demo": "node --test tests/demo/*.test.ts",
    "test:ui": "node --test tests/ui/*.test.ts",
    "typecheck": "tsc -p tsconfig.base.json && pnpm --filter @plotloom/ui typecheck && pnpm --filter @plotloom/web typecheck && pnpm --filter @plotloom/ui-demo typecheck",
    "test": "node --test tests/api/*.test.ts",
    "verify:real": "node --env-file-if-exists=.env scripts/verify-real.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
